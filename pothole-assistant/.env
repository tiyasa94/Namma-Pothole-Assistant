# ============================================================
# .env.example — copy to .env and fill in real values
# ============================================================

# ── Database ───────────────────────────────────────────────
# For Docker Compose, this is overridden automatically.
DATABASE_URL=postgresql+asyncpg://pothole:pothole@localhost:5432/potholedb

# ── Google Cloud Storage ───────────────────────────────────
GCS_BUCKET=pothole-blr-images
GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-service-account.json

# ── ML Engine ─────────────────────────────────────────────
# Place fine-tuned weights in the models/ directory.
YOLO_MODEL_PATH=models/yolov8n_pothole.pt
MASKRCNN_MODEL_PATH=models/maskrcnn_pothole.pth
ML_CONFIDENCE_THRESHOLD=0.50

# ── Firebase ──────────────────────────────────────────────
# Path to Firebase Admin SDK service account JSON.
FIREBASE_CREDENTIALS_JSON=/path/to/firebase-service-account.json

# ── App ───────────────────────────────────────────────────
APP_ENV=development          # development | production
SECRET_KEY=dev-secret-change-me
