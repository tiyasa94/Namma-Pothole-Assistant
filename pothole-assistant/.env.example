# ============================================================
# .env.example — copy to .env and fill in real values
#
# PROTOTYPE MODE: No cloud accounts needed.
# Everything runs locally with Docker Compose.
# ============================================================

# ── Database ───────────────────────────────────────────────
# Automatically overridden in Docker Compose.
# For bare uvicorn, point this at your local PostGIS instance.
DATABASE_URL=postgresql+asyncpg://pothole:pothole@localhost:5432/potholedb

# ── Local image storage ────────────────────────────────────
# Uploaded images are saved here and served at /uploads/<hash>.jpg
# Relative paths are resolved from the project root.
LOCAL_STORAGE_PATH=uploads

# ── ML Engine ─────────────────────────────────────────────
# YOLOv8 weights are auto-downloaded from a free public GitHub
# release on first run — no account or key needed.
# Delete models/yolov8n_pothole.pt to force a fresh download.
YOLO_MODEL_PATH=models/yolov8n_pothole.pt
MASKRCNN_MODEL_PATH=models/maskrcnn_pothole.pth
ML_CONFIDENCE_THRESHOLD=0.50
# Set to false to skip auto-download (e.g. in CI without internet)
ML_AUTO_DOWNLOAD=true

# ── App ───────────────────────────────────────────────────
APP_ENV=development
# BBMP operator token for POST /v1/maintenance.
# Any string works for local dev.  Generate a real one with:
#   openssl rand -hex 32
SECRET_KEY=dev-secret-change-me
